{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++ build active file",
			"command": "/usr/bin/g++",
			"args": [
				"-std=c++17",
				"-Wall",
				"-Wextra",
				"-g",
				"${fileDirname}/main.cpp",
				"${fileDirname}/absence.cpp",
				"-o",
				"${fileDirname}/simulateur_absences"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "compiler: /usr/bin/g++"
		}
	]
}